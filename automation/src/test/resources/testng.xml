<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MoneyMap Android E2E Suite" verbose="1" parallel="false" thread-count="1">

    <!-- Registered listeners -->
    <listeners>
        <listener class-name="com.example.moneymap.automation.listeners.TestNGListener" />
    </listeners>

    <!-- Main E2E test run — all 510+ test cases via DataProvider -->
    <test name="MoneyMap Appium E2E Tests">
        <classes>
            <class name="com.example.moneymap.automation.tests.E2EAutomationTest" />
        </classes>
    </test>

</suite>
