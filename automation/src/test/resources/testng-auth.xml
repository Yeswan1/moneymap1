<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MoneyMap Auth Shard" verbose="1" parallel="none">

  <listeners>
    <listener class-name="com.example.moneymap.automation.listeners.TestNGListener"/>
  </listeners>

  <!-- Shard filter: auth, register, session modules -->
  <!-- Filtering is applied in BaseTest.shouldIncludeTestCase() via -DtestShard=auth -->
  <test name="Auth Shard">
    <classes>
      <class name="com.example.moneymap.automation.tests.E2EAutomationTest"/>
    </classes>
  </test>

</suite>
