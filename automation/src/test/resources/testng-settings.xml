<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MoneyMap Settings Shard" verbose="1" parallel="none">

  <listeners>
    <listener class-name="com.example.moneymap.automation.listeners.TestNGListener"/>
  </listeners>

  <!-- Shard filter: settings, accessibility, responsive modules -->
  <!-- Filtering is applied in BaseTest.shouldIncludeTestCase() via -DtestShard=settings -->
  <test name="Settings Shard">
    <classes>
      <class name="com.example.moneymap.automation.tests.E2EAutomationTest"/>
    </classes>
  </test>

</suite>
